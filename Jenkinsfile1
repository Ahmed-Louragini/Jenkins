
pipeline {
    agent any

    options {
        timestamps()
    }

    stages {

        stage('Checkout') {
            steps {
                git url: 'https://github.com/Ahmed-Louragini/Jenkins.git',
                    branch: 'main'
            }
        }

        stage('Étape 1 : Build') {
            steps {
                bat 'echo === Étape 1 : Construction du projet ==='
                bat 'echo Vérification de la présence du fichier index.html'
                bat 'if not exist index.html exit /b 1'
                bat 'echo Build terminé avec succès'
            }
        }

        stage('Étape 2 : Test') {
            steps {
                bat 'echo === Étape 2 : Test du projet ==='
                bat 'dir'
                bat 'if not exist index.html exit /b 1'
                bat 'echo Test réussi : index.html existe'
            }
        }

        stage('Étape 3 : Deploy') {
            steps {
                bat 'echo === Étape 3 : Déploiement local ==='
                bat 'echo Le fichier index.html est prêt à être déployé'
            }
        }

        stage('Étape 4 : Fin du build') {
            steps {
                bat 'echo === Étape 4 : Fin du build ==='
                bat 'echo SUCCESS'
            }
        }
    }

    post {
        success {
            echo 'Build OK'
        }

        failure {
            echo 'Build KO'
        }
    }
}
